# PaperX Environment Configuration
# Copy this file to .env and configure your production credentials.
# Do not commit .env to public repositories.

# API or Webhook endpoint for form submissions (e.g., Supabase, Formspree, Resend, or your custom API)
# If left empty, forms run in interactive Preview/Demo Mode with simulated responses and inspection receipts.
VITE_INQUIRY_ENDPOINT=""

# Optional secret webhook authentication token (if required by your backend)
VITE_INQUIRY_AUTH_TOKEN=""

# Official WhatsApp Contact Number (Format: 91XXXXXXXXXX without symbols)
# If empty or placeholder, the WhatsApp button indicates that official chat support is in setup.
VITE_WHATSAPP_NUMBER=""

# Public Contact Support Email
VITE_CONTACT_EMAIL="contact@paperx.in"

# Base Application URL
VITE_APP_URL="https://paperx.in"
